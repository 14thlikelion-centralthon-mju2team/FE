# Ensom FE 환경변수 예시
# 복사해서 .env로 사용: cp .env.example .env
# .env는 .gitignore에 등록돼 있으므로 Git에 올라가지 않습니다.

# 카카오 SDK — 카카오 개발자 콘솔에서 발급
KAKAO_NATIVE_APP_KEY=
KAKAO_REST_API_KEY=

# Google OAuth — Google Cloud Console에서 발급한 Web 타입 클라이언트 ID
# BE가 idToken을 검증할 때 사용하는 것과 동일한 ID
GOOGLE_SERVER_CLIENT_ID=

# API 서버 주소
# 로컬: http://localhost:8080
# 배포: https://api.ensom.app/v1
API_BASE_URL=http://localhost:8080
